# KRTaker — LiteSpeed rewrites + security + caching
# - /api/<action>    -> api/index.php (API router reads REQUEST_URI)
# - /blog/<slug>     -> api/index.php (dynamic blog article renderer)
# - /building/<id>   -> building.html?pid=<id>  (public QR building profile)
# - /area/<slug>     -> area.html?jur=<slug>    (jurisdiction landing page)

# Disable directory listing everywhere (security)
Options -Indexes

# Custom 404 (branded page)
ErrorDocument 404 /404.html

# ── Security headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # HTTPS-only (site already forces HTTPS via rewrite below)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # HTML pages get a site CSP ('unsafe-inline' needed by inline scripts/styles;
  # blob: for the dashboard doc viewer). Exclude /api/* — PHP sets its OWN
  # stricter CSP (default-src 'none') and Apache "always set" would override it.
  <If "%{REQUEST_URI} !~ m#^/api#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' blob: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  </If>
</IfModule>

# ── Caching ───────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Versioned static assets (?v=...) — safe to cache forever
  <FilesMatch "\.(css|js|mjs|svg|png|jpg|jpeg|webp|gif|ico|woff2?|ttf|eot|json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML shells (CMS-hydrated client-side) — revalidate, never stale
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Service worker must never be cached stale
  <FilesMatch "^(sw|sw-dash|service-worker)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # API — never cache responses
  <FilesMatch "^index\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# ── Block sensitive files (defense in depth) ─────────────────────────────
<FilesMatch "^(\.env|\.git|\.htaccess|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json|.*\.(sql|db|sqlite|sqlite3|log|bak|old|swp))$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block access to leftover legacy admin tree (old third-party project, not KRTaker)
  RewriteRule ^admin/ - [F,L]
  RewriteRule ^_autoindex/ - [F,L]

  # Defense in depth: never execute PHP inside legacy/upload trees
  RewriteRule ^(admin/|uploads/).*\.(php|phtml|php3|php4|php5|php7|phar|pl|cgi|sh)$ - [F,L]

  # Force HTTPS (idempotent with host-level redirect)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Pretty single-segment URLs: /pricing -> /pricing.html (only if it exists)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^/.]+)/?$ $1.html [L]

  RewriteRule ^api/(.*)$ api/index.php [L,QSA]
  RewriteRule ^blog/([a-z0-9-]+)/?$ api/index.php [L,QSA]
  RewriteRule ^building/([A-Za-z0-9_-]+)/?$ building.html?pid=$1 [L,QSA]
  RewriteRule ^area/([a-z0-9-]+)/?$ area.html?jur=$1 [L,QSA]

  # IndexNow key file: /<32-hex>.txt -> API (Bing/Seznam site verification)
  RewriteRule ^([0-9a-f]{32})\.txt$ api/index.php [L,QSA]
</IfModule>
