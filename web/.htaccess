# KRTaker — LiteSpeed rewrites + security + caching
# - /api/<action>    -> api/index.php (API router reads REQUEST_URI)
# - /blog/<slug>     -> api/index.php (dynamic blog article renderer)
# - /building/<id>   -> building.html?pid=<id>  (public QR building profile)
# - /area/<slug>     -> area.html?jur=<slug>    (jurisdiction landing page)

# Disable directory listing everywhere (security)
Options -Indexes

# ── Security headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # HTTPS-only (site already forces HTTPS via rewrite below)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Caching ───────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Versioned static assets (?v=...) — safe to cache forever
  <FilesMatch "\.(css|js|mjs|svg|png|jpg|jpeg|webp|gif|ico|woff2?|ttf|eot|json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML shells (CMS-hydrated client-side) — revalidate, never stale
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Service worker must never be cached stale
  <FilesMatch "^(sw|sw-dash|service-worker)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # API — never cache responses
  <FilesMatch "^index\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# ── Block sensitive files (defense in depth) ─────────────────────────────
<FilesMatch "^(\.env|\.git|\.htaccess|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json|.*\.(sql|db|sqlite|sqlite3|log|bak|old|swp))$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block access to leftover legacy admin tree (old third-party project, not KRTaker)
  RewriteRule ^admin/ - [F,L]
  RewriteRule ^_autoindex/ - [F,L]

  # Defense in depth: never execute PHP inside legacy/upload trees
  RewriteRule ^(admin/|uploads/).*\.(php|phtml|php3|php4|php5|php7|phar|pl|cgi|sh)$ - [F,L]

  # Force HTTPS (idempotent with host-level redirect)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteRule ^api/(.*)$ api/index.php [L,QSA]
  RewriteRule ^blog/([a-z0-9-]+)/?$ api/index.php [L,QSA]
  RewriteRule ^building/([A-Za-z0-9_-]+)/?$ building.html?pid=$1 [L,QSA]
  RewriteRule ^area/([a-z0-9-]+)/?$ area.html?jur=$1 [L,QSA]
</IfModule>
